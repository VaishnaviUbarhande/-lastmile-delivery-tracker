# ==== Server ====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==== Database ====
# Local: mongodb://127.0.0.1:27017/lastmile
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lastmile?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lastmile

# ==== Auth ====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ==== Email (Nodemailer - any SMTP, e.g. Gmail App Password / Mailtrap / Brevo free tier) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Last-Mile Tracker <no-reply@lastmile.com>"

# ==== SMS (Twilio free trial) ====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Set to "true" to disable real email/SMS sending and just log to console
# (useful for local dev without credentials)
NOTIFICATIONS_DRY_RUN=true

# ==== Seed admin ====
SEED_ADMIN_EMAIL=admin@lastmile.com
SEED_ADMIN_PASSWORD=Admin@12345
